{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Sankalp Lesson Package",
  "description": "Rich lesson package produced by the ai-sankalp-video-assets skill. Cross-references (scene ids, asset ids, code example ids) are checked by ai_sankalp.package.validate_package.",
  "type": "object",
  "required": [
    "topic", "slug", "title", "language", "language_version", "audience",
    "prerequisites", "difficulty", "duration_minutes", "lesson_objective",
    "short_description", "course_category", "voice_profile", "scenes",
    "code_examples", "assets", "voiceover_segments", "tags", "output_filename",
    "output_folder_name", "branding", "generator_compatibility"
  ],
  "properties": {
    "topic": {"$ref": "#/$defs/text"},
    "slug": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/text"},
    "language": {"$ref": "#/$defs/text"},
    "language_version": {"type": "string"},
    "audience": {"$ref": "#/$defs/text"},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "difficulty": {"type": "string", "enum": ["beginner", "intermediate", "advanced"]},
    "duration_minutes": {"type": "number", "minimum": 0.1, "maximum": 60},
    "lesson_objective": {"$ref": "#/$defs/text"},
    "short_description": {"$ref": "#/$defs/text"},
    "course_category": {"type": "string"},
    "voice_profile": {"$ref": "#/$defs/voiceProfile"},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "code_examples": {"type": "array", "items": {"$ref": "#/$defs/codeExample"}},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "voiceover_segments": {"type": "array", "items": {"$ref": "#/$defs/voiceoverSegment"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "output_filename": {"type": "string", "pattern": "^[a-z0-9_]+\\.mp4$"},
    "output_folder_name": {"$ref": "#/$defs/id"},
    "visual_template": {"type": "string", "enum": ["standard", "futuristic_array"]},
    "review_status": {"$ref": "#/$defs/reviewStatus"},
    "branding": {"$ref": "#/$defs/branding"},
    "generator_compatibility": {"$ref": "#/$defs/generatorCompatibility"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
    "stringList": {"type": "array", "items": {"type": "string"}},
    "hexColor": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "voiceProfile": {
      "type": "object",
      "required": ["persona", "accent_language", "target_pace_wpm", "tone"],
      "properties": {
        "persona": {"type": "string"},
        "accent_language": {"type": "string"},
        "target_pace_wpm": {"type": "integer", "minimum": 60, "maximum": 240},
        "speed_multiplier": {"type": "number", "minimum": 0.5, "maximum": 2.0},
        "tone": {"type": "string"},
        "energy": {"type": "string"},
        "modulation": {"type": "string"},
        "pronunciation_dictionary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["written", "spoken"],
            "properties": {"written": {"type": "string"}, "spoken": {"type": "string"}}
          }
        },
        "provider_notes": {"type": "string"}
      }
    },
    "voiceDelivery": {
      "type": "object",
      "properties": {
        "pace_wpm": {"type": "integer", "minimum": 60, "maximum": 240},
        "tone": {"type": "string"},
        "energy": {"type": "string"},
        "modulation": {"type": "string"},
        "emphasis_words": {"$ref": "#/$defs/stringList"},
        "pronunciation_notes": {"$ref": "#/$defs/stringList"},
        "pause_before_seconds": {"type": "number", "minimum": 0, "maximum": 10},
        "pause_after_seconds": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id", "type", "title", "purpose", "voiceover", "on_screen_text",
        "visual_objects", "code_example_ids", "timing_seconds"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {
          "description": "Controlled values: intro, motivation, explanation, code_walkthrough, visual_trace, common_mistake, practice, summary, outro.",
          "$ref": "#/$defs/id"
        },
        "title": {"$ref": "#/$defs/text"},
        "purpose": {"type": "string"},
        "voiceover": {"$ref": "#/$defs/text"},
        "voice_delivery": {"$ref": "#/$defs/voiceDelivery"},
        "on_screen_text": {"$ref": "#/$defs/stringList"},
        "visual_objects": {"$ref": "#/$defs/stringList"},
        "visuals": {
          "description": "Optional primitives drawn by the futuristic_array template, in order. Without it, a default is chosen by scene type.",
          "type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/sceneVisual"}
        },
        "animation_notes": {"$ref": "#/$defs/stringList"},
        "code_example_ids": {"$ref": "#/$defs/stringList"},
        "timing_seconds": {"type": "number", "minimum": 1, "maximum": 600},
        "transition": {"type": "string"}
      }
    },
    "codeExample": {
      "type": "object",
      "required": ["id", "purpose", "code", "expected_output"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "purpose": {"type": "string"},
        "runtime": {"type": "string"},
        "code": {"$ref": "#/$defs/text"},
        "explanation_steps": {"$ref": "#/$defs/stringList"},
        "expected_output": {"type": "string"},
        "output_is_representative": {"type": "boolean"},
        "beginner_mistakes": {"$ref": "#/$defs/stringList"},
        "practice_variation": {"type": "string"}
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "purpose", "source_strategy"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string"},
        "purpose": {"type": "string"},
        "suggested_filename": {"type": "string"},
        "description": {"type": "string"},
        "source_strategy": {"type": "string", "enum": ["manim", "reuse", "generate"]},
        "format": {"type": "string"},
        "manim_construction": {"type": ["string", "null"]},
        "image_generation_prompt": {"type": ["string", "null"]}
      }
    },
    "voiceoverSegment": {
      "type": "object",
      "required": ["id", "scene_id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "scene_id": {"$ref": "#/$defs/id"},
        "text": {"$ref": "#/$defs/text"},
        "estimated_seconds": {"type": "number", "minimum": 0},
        "pace_wpm": {"type": "integer", "minimum": 60, "maximum": 240},
        "tone": {"type": "string"},
        "energy": {"type": "string"},
        "modulation": {"type": "string"},
        "emphasis_words": {"$ref": "#/$defs/stringList"},
        "pronunciation_notes": {"$ref": "#/$defs/stringList"},
        "pause_before_seconds": {"type": "number", "minimum": 0, "maximum": 10},
        "pause_after_seconds": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "branding": {
      "type": "object",
      "required": ["logo_asset_id", "logo_position", "footer_text"],
      "properties": {
        "logo_asset_id": {"$ref": "#/$defs/id"},
        "logo_position": {"type": "string", "enum": ["upper_right_safe_area"]},
        "footer_text": {"type": "string"},
        "palette": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hexColor"}}
      }
    },
    "generatorCompatibility": {
      "description": "Reduced render config embedded in the package. topic, title and language come from the package top level.",
      "type": "object",
      "required": ["sections", "code_example", "summary", "output_video_name", "voiceover"],
      "properties": {
        "visual_template": {"type": "string", "enum": ["standard", "futuristic_array"]},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
        "code_example": {"$ref": "#/$defs/text"},
        "summary": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
        "output_video_name": {"$ref": "#/$defs/id"},
        "voiceover": {"$ref": "#/$defs/voiceover"}
      }
    },
    "section": {
      "oneOf": [
        {"type": "string", "minLength": 1, "pattern": "\\S"},
        {
          "type": "object",
          "required": ["bullets"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "bullets": {
              "oneOf": [
                {"type": "string", "minLength": 1, "pattern": "\\S"},
                {"type": "array", "minItems": 1, "items": {"type": "string"}}
              ]
            },
            "narration": {"type": "string"},
            "visual": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/visual"}]}
          }
        }
      ]
    },
    "reviewStatus": {
      "description": "Subject-matter expert sign-off. A lesson is final-ready only when sme_approved is true and every checklist item is pass. See docs/review-checklist.md.",
      "type": "object",
      "required": ["sme_approved"],
      "properties": {
        "sme_approved": {"type": "boolean"},
        "sme_reviewer": {"type": ["string", "null"]},
        "sme_approved_on": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "notes": {"type": "string"},
        "checklist": {
          "type": "object",
          "properties": {
            "pedagogy": {"$ref": "#/$defs/checklistValue"},
            "pacing": {"$ref": "#/$defs/checklistValue"},
            "readability": {"$ref": "#/$defs/checklistValue"},
            "brand": {"$ref": "#/$defs/checklistValue"}
          }
        }
      }
    },
    "checklistValue": {"type": "string", "enum": ["pending", "pass", "needs_review"]},
    "sceneVisual": {
      "description": "A primitive for a package scene. type selects it; other keys are its parameters, validated by ai_sankalp/primitives/specs.py. See docs/templates.md.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["flow", "steps", "compare", "table", "title_card", "card_merge", "array_lane", "token_breakdown", "index_access", "code_walkthrough", "loop_trace", "bounds_check", "practice_reveal", "concept_map", "outro_card", "bullet_card"]},
        "title": {"type": "string", "maxLength": 48},
        "label": {"type": "string", "maxLength": 40},
        "timing": {"type": "string", "enum": ["narrated", "after_narration"]}
      }
    },
    "visual": {
      "description": "Optional explicit section visual. type selects the primitive; other keys are its parameters, validated by ai_sankalp/primitives/specs.py. See README 'Section visuals'.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["flow", "steps", "compare", "table", "array_lane", "loop_trace", "concept_map"]},
        "title": {"type": "string", "maxLength": 48}
      }
    },
    "voiceover": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "language": {"type": "string", "description": "gTTS language code, e.g. en."},
            "tld": {"type": "string", "description": "gTTS Google domain, e.g. co.in for an Indian English accent."},
            "speed": {"type": "number", "minimum": 0.5, "maximum": 2.0},
            "provider": {"type": "string", "enum": ["gtts", "edge"]},
            "voice": {"type": "string", "description": "Edge TTS voice name, e.g. en-IN-NeerjaNeural."},
            "rate": {"type": "string", "pattern": "^[+-]\\d+%$", "description": "Edge TTS rate, e.g. -4%."},
            "pitch": {"type": "string", "pattern": "^[+-]\\d+Hz$", "description": "Edge TTS pitch, e.g. +1Hz."},
            "human_delivery_notes": {"type": "string", "description": "Informational only; not used at render time."}
          }
        }
      ]
    }
  }
}
