{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Sankalp Lesson",
  "type": "object",
  "required": ["topic", "title", "language", "code_example", "output_video_name"],
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "bullets"],
        "properties": {
          "title": {"type": "string"},
          "bullets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "narration": {"type": "string"}
        }
      }
    },
    "explanation": {"type": ["string", "array"]},
    "code_example": {"type": "string", "minLength": 1},
    "summary": {"type": ["string", "array"]},
    "output_video_name": {"type": "string", "minLength": 1},
    "voiceover": {
      "oneOf": [
        {"type": "boolean"},
        {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "language": {"type": "string"},
            "tld": {"type": "string"},
            "speed": {"type": "number", "minimum": 0.5, "maximum": 2.0}
          }
        }
      ]
    }
  }
}
